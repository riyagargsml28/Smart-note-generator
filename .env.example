# ==============================================================================
# Smart Notes Generator - Environment Configuration Template
# Copy this file to '.env' and populate your credentials if using external APIs.
# ==============================================================================

# Server Settings
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1
SECRET_KEY=smart-notes-secret-key-lecture-ai-2026

# OpenAI Credentials (Optional)
# If provided, enables GPT-4o-mini structured note synthesis and Whisper ASR audio transcription.
# If omitted, the application runs out-of-the-box using the built-in Academic Heuristic Engine!
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# Offline / Heuristic Fallback Mode
# Set to 'True' to gracefully use the local semantic analyzer when offline or without an API key.
ALLOW_OFFLINE_FALLBACK=True
